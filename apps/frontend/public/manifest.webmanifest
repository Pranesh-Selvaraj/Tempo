{
  "name": "Tempo \u2014 3D Volleyball Play Designer",
  "short_name": "Tempo",
  "description": "Author 3D volleyball plays, choreograph cameras, record video, teach on any device.",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#000000",
