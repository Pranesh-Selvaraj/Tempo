# Backend
PORT=4000
# Postgres 16 (Docker Compose). If you cannot run Docker, use the embedded
# database instead by setting: DATABASE_URL=pglite://./.pglite
DATABASE_URL=postgresql://postgres:password@localhost:5432/rotation_db
JWT_SECRET=replace_with_a_long_random_string
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000
NODE_ENV=development

# Optional: Cloudflare R2 for shareable recording files (Sprint 10).
# When these are set, /api/upload stores recordings in R2 instead of apps/backend/uploads.
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret_key
# R2_BUCKET=tempo-recordings
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Frontend (Vite)
VITE_API_URL=http://localhost:4000
